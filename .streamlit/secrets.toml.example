AZURE_TENANT_ID = "YOUR_TENANT_ID"
AZURE_CLIENT_ID = "YOUR_CLIENT_ID"

# Option A: Delegated permissions via device code flow (no secret)
# Leave AZURE_CLIENT_SECRET unset.

# Option B: Application permissions (client credentials)
# Uncomment and set if you created a client secret for app-only access
# AZURE_CLIENT_SECRET = "YOUR_CLIENT_SECRET"

# Local dev redirect URI (must match Azure App Registration)
# AZURE_REDIRECT_URI = "http://localhost:8501"
